{
  "name": "ai-blog",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "app:startup": "npm run env:setup && npm run infra:up && npm run migrate:up",
    "env:setup": "cp .env.example .env",
    "infra:up": "docker-compose up -d",
    "infra:restart": "docker-compose restart",
    "infra:down": "docker-compose down",
    "migrate:up": "postgrator",
    "migrate:down": "postgrator drop-schema"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@mastra/core": "1.61.0",
    "@mastra/loggers": "1.2.0",
    "@types/pg": "8.23.1",
    "mastra": "1.26.0",
    "nanoid": "6.0.1",
    "ollama-ai-provider-v2": "4.0.1",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "postgrator-cli": "10.0.0"
  }
}
