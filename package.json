{
  "name": "ai-blog",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "app:startup": "npm run env:setup && npm run infra:up && npm run migrate:up",
    "env:setup": "cp .env.example .env",
    "infra:up": "docker-compose up -d",
    "infra:restart": "docker-compose restart",
    "infra:down": "docker-compose down",
    "migrate:up": "postgrator",
    "migrate:down": "postgrator drop-schema",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@mastra/core": "1.61.0",
    "@mastra/loggers": "1.2.0",
    "@types/pg": "8.23.1",
    "mastra": "1.26.0",
    "nanoid": "6.0.1",
    "ollama-ai-provider-v2": "4.0.1",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "lefthook": "2.1.10",
    "lint-staged": "17.4.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "postgrator-cli": "10.0.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "npm run lint:fix",
      "npm run fmt"
    ]
  }
}
